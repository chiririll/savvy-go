{
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "jsx": "react-jsx",
        "strict": true,
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "skipLibCheck": true,
        "types": ["vite/client"],
        "paths": {
            "@/*": ["./resources/ts/*"]
        },
        "allowImportingTsExtensions": true,
        "noEmit": true
    },
    "include": [
        "resources/ts/**/*",
        "vite.config.ts",
        "scripts/**/*",
        "deploy/**/*.mts"
    ]
}
