# After changing values, re-run:
#   sudo APP_DIR=/opt/savvy-go DATA_DIR=/var/lib/savvy-go /opt/savvy-go/scripts/bootstrap.sh
#   sudo systemctl restart savvy-go-queue savvy-go-scheduler
#
