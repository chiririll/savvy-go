[Unit]
Description=Savvy expense tracker
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
Environment=DATA_DIR=/var/lib/savvy
Environment=PUBLIC_DIR=/opt/savvy/public
Environment=LISTEN_ADDR=:8080
EnvironmentFile=-/etc/savvy/install.env
ExecStart=/usr/bin/savvy
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
