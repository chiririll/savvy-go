[Unit]
Description=Go Savvy - expense tracker
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
Environment=DATA_DIR=/var/lib/savvy-go
Environment=PUBLIC_DIR=/opt/savvy-go/public
Environment=LISTEN_ADDR=:8080
EnvironmentFile=-/etc/savvy-go/install.env
ExecStart=/usr/bin/savvy-go
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
