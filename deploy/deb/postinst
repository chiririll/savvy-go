#!/bin/sh
set -e

DATA_DIR=/var/lib/savvy

case "$1" in
    configure)
        mkdir -p "$DATA_DIR"
        chown -R www-data:www-data "$DATA_DIR" /opt/savvy 2>/dev/null || true

        if [ -d /run/systemd/system ]; then
            systemctl daemon-reload
            systemctl enable savvy.service >/dev/null
            systemctl restart savvy.service
        fi
        ;;
esac

exit 0
