[Unit]
Description=Go Savvy - expense tracker
After=network.target

[Service]
Type=simple
User=@APP_USER@
Group=@APP_USER@
# The only environment the app reads. The web UI is built into the binary.
Environment=CONFIG_FILE=/etc/savvy-go/config.toml
ExecStart=/usr/bin/savvy-go
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
