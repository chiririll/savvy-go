[Unit]
Description=Go Savvy - expense tracker
After=network.target

[Service]
Type=simple
User=@APP_USER@
Group=@APP_USER@
# The only environment the app reads; the frontend is public/ below the working directory.
Environment=CONFIG_FILE=/etc/savvy-go/config.toml
WorkingDirectory=/usr/share/savvy-go
ExecStart=/usr/bin/savvy-go
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
