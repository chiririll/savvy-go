#!/bin/sh
set -e

checkpoint_wal() {
    if [ -f /var/lib/savvy-go/database.sqlite ] && command -v sqlite3 >/dev/null 2>&1; then
        runuser -u www-data -- sqlite3 /var/lib/savvy-go/database.sqlite \
            "PRAGMA wal_checkpoint(TRUNCATE);" || true
    fi
}

case "$1" in
    upgrade)
        if [ -d /run/systemd/system ]; then
            systemctl stop savvy-go.service || true
        fi
        checkpoint_wal
        ;;
    remove|deconfigure)
        if [ -d /run/systemd/system ]; then
            systemctl disable --now savvy-go.service || true
        fi
        checkpoint_wal
        ;;
esac

exit 0
