{
    "$schema": "https://www.schemastore.org/package.json",
    "name": "savvy-go",
    "private": true,
    "type": "module",
    "scripts": {
        "prepare": "msw init .storybook/public --no-save",
        "build": "vite build",
        "dev": "vite",
        "logos": "npm --prefix scripts run logos",
        "screenshots": "npm --prefix scripts run screenshots --",
        "screenshots:diff": "npm --prefix scripts run screenshots:diff",
        "test": "vitest run --project unit",
        "test:stories": "vitest run --config vitest.stories.config.ts --project stories-desktop --project stories-mobile",
        "test:stories:full": "node scripts/test-stories-full.mts",
        "storybook": "storybook dev -p 6006",
        "build-storybook": "storybook build -o storybook-static",
        "audit": "node resources/ts/lib/code-shape/audit.ts"
    },
    "devDependencies": {
