APP_URL=http://localhost:8080
LISTEN_ADDR=localhost:8080
TZ=UTC

# SQLite and uploads (defaults to ./data locally)
# DATA_DIR=./data
# DB_DATABASE=
# UPLOAD_ROOT=
# BACKUP_PATH=
# PUBLIC_DIR=public

# AUTH_SESSION_COOKIE=svy_session
# AUTH_SESSION_CSRF_COOKIE=svy_csrf
# AUTH_SESSION_CSRF_HEADER=X-CSRF-Token
# AUTH_SESSION_TTL=1440
# AUTH_SESSION_REMEMBER_TTL=10080
# AUTH_SESSION_CHALLENGE_TTL=5

# First boot only: seed demo users, accounts, and ~12 months of transactions.
# No-op on later starts once users exist.
SEED_DEMO=true

# Legacy Laravel APP_KEY (`base64:…`) — required to unwrap encrypted TOTP secrets
# after importing a Laravel-era database. Also read from DATA_DIR/.env_config.
# APP_KEY=
